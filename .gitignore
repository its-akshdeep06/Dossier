# Environment files (keep .env.example tracked, ignore actual secret keys and locals)
.env*.local
env/*.local
env/.env
env/.env.*
!env/.env.example
!env/.env.development
!env/.env.production
# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Nitro build output, once this app has a server. Both are regenerated by
# every build, and the deploy runs one before reading them.
.output
.wrangler

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vite
